> dass_ut <- upper.tri(dass_same)
> dass_sep <- t(sapply(dass_sim, function(sm)
+   c(within  = mean(sm[dass_same & dass_ut]),
+     between = mean(sm[!dass_same & dass_ut]),
+     rpb     = cor(sm[dass_ut], as.numeric(dass_same[dass_ut])))))
