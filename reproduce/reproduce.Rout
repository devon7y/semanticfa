> ## Vetting brand-new candidate items runs in the SAME 8B space as every
> ## other analysis: the three candidates were embedded offline with
> ## Qwen/Qwen3-Embedding-8B (identical settings to the item vectors; see
> ## data-raw/embed_candidates_8B.py) and ship in the reproduction archive,
> ## and the five construct-name vectors are the auxiliary 8B vectors loaded
> ## in Section 1. sfa_item_fit() uses only the item embeddings, their
> ## theoretical labels, and the construct-name vectors, so this reference fit
> ## is equivalent to the main one; the scoring column is left out because the
> ## keying-free mean_centered_pearson encoding does not use it.
> fit_ns <- sfa(big5_df[, c("code", "item", "factor")],
+               embeddings = E8,
+               encoding = "mean_centered_pearson", nfactors = 5)
> ## two planted flaws (a cross-loader and a near-duplicate) plus one
> ## genuine addition expected to pass
> cand <- c("I make friends easily.",
+           "I am the life of every party.",
+           "I finish what I start.")
> cand8 <- sfa_load_npz(CAND_NPZ)
> stopifnot(identical(cand8$items, cand))
> ## offline lookup embedder: candidate vectors from the archive, construct
> ## names from the auxiliary vectors (no live model, no Python)
> embed_lookup8 <- function(texts) {
+   pool_texts <- c(cand8$items, aux$codes)
+   pool_emb   <- rbind(cand8$embeddings, aux$embeddings)
+   idx <- match(tolower(trimws(texts)), tolower(trimws(pool_texts)))
+   stopifnot(!anyNA(idx))
+   pool_emb[idx, , drop = FALSE]
+ }
> ifit <- sfa_item_fit(fit_ns, cand, embed = embed_lookup8,
+                      redundancy_cutoff = 0.85)
